SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres
EXPKIT_DASHBOARD_PORT=8421
EXPKIT_DOCKER=1
EXPKIT_EXECUTION_MODE=local

# AWS mode settings
AWS_PROFILE=expkit
AWS_ACCOUNT_ID=123456789012
EXPKIT_AWS_REGIONS=us-east-1,us-east-2
EXPKIT_SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/expkit-sagemaker-exec
EXPKIT_AWS_S3_BUCKET=your-expkit-bucket
EXPKIT_MAX_BUDGET_USD_PER_RUN=50
EXPKIT_AWS_COMPUTE=cpu
EXPKIT_AWS_USE_SPOT=0
